    "bip39": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "bip39": {
      "optional": true
    }
  },
  "devDependencies": {
    "@stellar/stellar-sdk": "^14.3.0",
    "@types/jest": "^29.5.14",
    "bip39": "^3.1.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
