{
  "name": "@coixa/stellar",
  "version": "0.1.0",
  "description": "Typed transaction pipeline and Horizon/RPC provider routing for Stellar-compatible networks (Stellar, Pi Network).",
  "license": "Apache-2.0",
  "author": "Coixa",
  "repository": {
    "type": "git",
    "url": "https://github.com/coixa-labs/stellar.git"
  },
  "homepage": "https://github.com/coixa-labs/stellar#readme",
  "bugs": {
    "url": "https://github.com/coixa-labs/stellar/issues"
  },
  "keywords": [
    "stellar",
    "pi-network",
    "pi",
    "horizon",
    "soroban",
    "rpc",
    "transaction",
    "wallet",
    "blockchain"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
